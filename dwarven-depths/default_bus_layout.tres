[gd_resource type="AudioBusLayout" format=3]

; Master, plus SFX and Music routed into it.
;
; The volume control used to move Master, which would have dimmed the music
; along with the digging as soon as music existed. Splitting the buses is what
; lets the two sliders on the title screen mean different things.

[resource]
bus/1/name = &"SFX"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/2/name = &"Music"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"
